<resources>
    <!-- Android 12+ system splash: MailOS plane on dark charcoal, then straight into the app. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#14B8A6</item>
        <item name="android:windowBackground">@color/mailos_surface</item>
        <item name="android:colorBackground">@color/mailos_surface</item>
        <item name="android:statusBarColor">@color/mailos_surface</item>
        <item name="android:navigationBarColor">@color/mailos_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/mailos_surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/mailos_airplane_adaptive</item>
    </style>
</resources>
